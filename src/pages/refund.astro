---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Refund Policy | GRICH" description="Refund Policy for GRICH digital products.">
  <main class="min-h-screen bg-slate-950 text-slate-300 py-20 px-4">
    <div class="max-w-3xl mx-auto space-y-8">
      <h1 class="text-4xl font-bold text-white mb-8">Refund Policy</h1>
      
      <section class="space-y-4">
        <h2 class="text-2xl text-white font-semibold">Digital Products</h2>
        <p>Due to the nature of our products (instant digital downloads of Intelligence Reports), <strong>all sales are final</strong>. We cannot offer refunds once the report has been generated or downloaded.</p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl text-white font-semibold">Exceptions</h2>
        <p>If you have been charged but failed to receive the product due to a technical error, please contact support immediately for a full refund or re-delivery.</p>
      </section>

      <div class="pt-8 border-t border-slate-800">
        <a href="/" class="text-red-500 hover:text-red-400">← Back to Home</a>
      </div>
    </div>
  </main>
</Layout>
