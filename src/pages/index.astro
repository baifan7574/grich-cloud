---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GRICH | Global Regulatory Lawsuit Search Engine" description="Search global trademark infringement lawsuits and compliance alerts. Monitoring 500+ brands daily.">
  
  <!-- Main Container with inline fallback styles -->
  <main class="min-h-screen flex flex-col items-center justify-center p-4 relative overflow-hidden" style="background-color: #020617; min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative;">
    
    <!-- Background Effects (CSS Grid Overlay) -->
    <div style="position: absolute; top:0; left:0; width:100%; height:100%; overflow: hidden; pointer-events: none; z-index: 0;">
      <div style="position: absolute; top: -20%; left: -10%; width: 50%; height: 50%; background: rgba(59, 130, 246, 0.1); border-radius: 50%; filter: blur(100px);"></div>
      <div style="position: absolute; top: 40%; right: -10%; width: 40%; height: 40%; background: rgba(239, 68, 68, 0.1); border-radius: 50%; filter: blur(100px);"></div>
    </div>

    <div class="relative z-10 w-full max-w-2xl text-center space-y-8" style="z-index: 10; width: 100%; max-width: 42rem; text-align: center;">
      
      <!-- Logo / Header -->
      <div class="space-y-2" style="margin-bottom: 2rem;">
        <h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter" style="font-size: 3.75rem; font-weight: 900; color: white; letter-spacing: -0.05em; margin: 0;">
          GRICH <span class="text-red-500" style="color: #ef4444;">INTEL</span>
        </h1>
        <p class="text-slate-400 text-lg md:text-xl font-light tracking-wide" style="color: #94a3b8; font-size: 1.25rem; font-weight: 300; letter-spacing: 0.05em; margin-top: 0.5rem;">
          Global Lawsuit & Compliance Search Engine
        </p>
      </div>

      <!-- Search Box (Glassmorphism Hardcoded) -->
      <div class="group" style="width: 100%; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(10px); border: 1px solid #334155; border-radius: 1rem; padding: 0.75rem; display: flex; align-items: center; gap: 0.5rem; transition: all 0.3s; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
        <div class="pl-4 text-slate-500" style="padding-left: 1rem; color: #64748b;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <input 
          type="text" 
          id="brand-search"
          placeholder="Enter Brand Name (e.g. Nike, Shein, Dyson)..." 
          class="bg-transparent border-none outline-none text-white text-lg w-full placeholder-slate-600 h-12"
          style="background: transparent; border: none; outline: none; color: white; font-size: 1.125rem; width: 100%; height: 3rem;"
          onkeydown="if(event.key === 'Enter') document.getElementById('search-btn').click()"
        />
        <button 
          id="search-btn"
          class="bg-red-600 hover:bg-red-500 text-white font-bold px-6 py-3 rounded-xl transition-all shadow-lg hover:shadow-red-500/20"
          style="background-color: #dc2626; color: white; font-weight: 700; padding: 0.75rem 1.5rem; border-radius: 0.75rem; border: none; cursor: pointer; transition: background 0.3s;"
          onmouseover="this.style.backgroundColor='#ef4444'"
          onmouseout="this.style.backgroundColor='#dc2626'"
        >
          SEARCH
        </button>
      </div>

      <!-- Footer / Trust -->
      <div class="pt-8 flex flex-col items-center gap-4" style="padding-top: 2rem; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
        <p class="text-xs text-slate-600 uppercase tracking-widest font-semibold" style="font-size: 0.75rem; color: #475569; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">
          Trusted Intelligence Source
        </p>
        <div class="flex gap-4 opacity-30 grayscale items-center justify-center" style="display: flex; gap: 1rem; opacity: 0.3; filter: grayscale(100%); align-items: center; justify-content: center;">
             <span style="color: #94a3b8; font-family: serif; font-weight: 700; font-size: 1.25rem;">COURT<span style="color: #475569;">LISTENER</span></span>
             <span style="color: #475569;">|</span>
             <span style="color: #94a3b8; font-family: sans-serif; font-weight: 700; font-size: 1.25rem;">PACER</span>
        </div>
      </div>

    </div>

    <!-- Live Intelligence Ticker (Fixed Bottom) -->
    <div style="position: fixed; bottom: 0; left: 0; right: 0; width: 100%; background: rgba(15, 23, 42, 0.95); border-top: 1px solid rgba(239, 68, 68, 0.2); padding: 0.75rem 0; z-index: 50; backdrop-filter: blur(4px); display: flex; align-items: center; overflow: hidden;">
        <div style="display: block; background-color: #dc2626; color: white; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.75rem; margin-left: 1rem; border-radius: 0.25rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); white-space: nowrap; z-index: 60;">
            LIVE FEED
        </div>
        <div class="flex whitespace-nowrap animate-scroll-left hover:pause-animation" style="display: flex; white-space: nowrap; flex: 1; overflow: hidden;">
            {/* Repeated items for smooth loop */}
            {[1, 2, 3].map(() => (
                <div class="flex gap-8 mx-4 text-xs font-mono text-slate-400" style="display: flex; gap: 2rem; margin: 0 1rem; font-size: 0.75rem; font-family: monospace; color: #94a3b8;">
                    <span style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background-color: #ef4444; display: inline-block;"></span> NIKE: Case #26-0029 Detected (N.D. Ill)</span>
                    <span style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background-color: #f97316; display: inline-block;"></span> SHEIN: Risk Level High (TRO Pending)</span>
                    <span style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background-color: #ef4444; display: inline-block;"></span> DYSON: Asset Freeze Executed</span>
                    <span style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background-color: #eab308; display: inline-block;"></span> LV: Settlement Negotiations</span>
                    <span style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background-color: #ef4444; display: inline-block;"></span> DAIMLER: 24h Deadline Alert</span>
                </div>
            ))}
        </div>
    </div>
  </main>

  <style is:global>
    @keyframes scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-33.33%); }
    }
    .animate-scroll-left {
        animation: scroll 30s linear infinite;
    }
    .hover\:pause-animation:hover {
        animation-play-state: paused;
    }
  </style>

  <script>
    document.getElementById('search-btn').addEventListener('click', () => {
        const input = document.getElementById('brand-search') as HTMLInputElement;
        const val = input.value.trim();
        if (val) {
            // Redirect to the dynamic route
            window.location.href = `/compliance/${encodeURIComponent(val)}`;
        }
    });
  </script>
</Layout>
