---
import Layout from '../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="GRICH | System Status">
    <div class="flex items-center justify-center h-screen bg-slate-950 text-white">
        <div class="text-center">
            <h1 class="text-6xl font-bold mb-4">GRICH <span class="text-red-500">INTEL</span></h1>
            <p class="text-xl text-slate-400">System Status: <span class="text-green-500">ONLINE</span></p>
            <p class="text-sm text-slate-600 mt-4">Pipeline Check v3.0</p>
            <div class="mt-8">
                 <a href="/compliance/NIKE" class="text-blue-400 hover:underline">Check Test Brand (NIKE)</a>
            </div>
        </div>
    </div>
</Layout>
