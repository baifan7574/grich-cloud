---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy | GRICH" description="Privacy Policy for GRICH. How we handle your data.">
  <main class="min-h-screen bg-slate-950 text-slate-300 py-20 px-4">
    <div class="max-w-3xl mx-auto space-y-8">
      <h1 class="text-4xl font-bold text-white mb-8">Privacy Policy</h1>
      
      <section class="space-y-4">
        <h2 class="text-2xl text-white font-semibold">1. Data Collection</h2>
        <p>We do not collect personal data unless you voluntarily provide it during the purchase process (handled via PayPal/Lemon Squeezy).</p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl text-white font-semibold">2. Usage of Data</h2>
        <p>Any email address provided is used solely for delivering your purchased Digital Compliance Report.</p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl text-white font-semibold">3. Cookies</h2>
        <p>We use essential cookies to ensure the website functions correctly and to analyze anonymous traffic data.</p>
      </section>

      <div class="pt-8 border-t border-slate-800">
        <a href="/" class="text-red-500 hover:text-red-400">← Back to Home</a>
      </div>
    </div>
  </main>
</Layout>
