---
layout: '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
import PayPalButton from '../../components/PayPalButton.astro';

const { defendant } = Astro.params;
const decodedDefendant = decodeURIComponent(defendant || '');

// Initialize Supabase
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || process.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || process.env.PUBLIC_SUPABASE_ANON_KEY;

let dbRecord = null;
let riskScore = 15; // Low risk by default
let isMatch = false;
let statusMessage = "NO RECORDS FOUND";
let evidenceLink = "";

// Query Database (SSR)
if (supabaseUrl && supabaseKey && decodedDefendant) {
  try {
    const supabase = createClient(supabaseUrl, supabaseKey);
    // Search exact match first, case insensitive
    const { data, error } = await supabase
      .from('defendants')
      .select('*')
      .ilike('defendant_name', decodedDefendant)
      .limit(1)
      .single();

    if (data) {
      dbRecord = data;
      isMatch = true;
      riskScore = 99; // Critical Risk
      statusMessage = "CRITICAL MATCH CONFIRMED";
      // Use the store_url or sharepoint link if we have it in the future
      evidenceLink = "https://gbcnet-my.sharepoint.com/:f:/g/personal/jmachuca_gbc_law/ElM4QXTLf1pPrGW52eX4JO0BGkxnCmOiuXOyk5XncXWWTg?e=4EL9qs"; 
    }
  } catch (e) {
    console.error("Supabase Query Error:", e);
  }
}
---

<div class="min-h-screen bg-[#050505] text-white">
  <!-- Emergency Header -->
  <div class={`border-b p-4 ${isMatch ? 'bg-red-900/40 border-red-500/50 animate-pulse' : 'bg-gray-900/40 border-gray-700'}`}>
    <div class="container mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="relative flex h-3 w-3">
          <span class={`absolute inline-flex h-full w-full rounded-full opacity-75 ${isMatch ? 'animate-ping bg-red-400' : 'bg-gray-400'}`}></span>
          <span class={`relative inline-flex rounded-full h-3 w-3 ${isMatch ? 'bg-red-500' : 'bg-gray-500'}`}></span>
        </span>
        <span class={`font-mono font-bold tracking-wider ${isMatch ? 'text-red-400' : 'text-gray-400'}`}>
          {isMatch ? 'CRITICAL ALERT: DEFENDANT MATCH FOUND' : 'SYSTEM STATUS: DATA ANALYSIS COMPLETE'}
        </span>
      </div>
      <span class="font-mono text-xs text-gray-500/80">ID: {decodedDefendant}</span>
    </div>
  </div>

  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Header Section -->
    <div class="mb-12 text-center">
      <h1 class="text-5xl md:text-7xl font-black mb-4 tracking-tighter uppercase relative inline-block">
        <span class="text-transparent bg-clip-text bg-gradient-to-b from-white to-gray-500">Target:</span>
        <span class={isMatch ? "text-red-500" : "text-gray-400"}>{decodedDefendant}</span>
      </h1>
      
      {isMatch ? (
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Our intelligence network has detected that <strong class="text-white">{decodedDefendant}</strong> has been named as a defendant in a recent federal IP lawsuit. 
          <span class="text-red-400 block mt-2 font-bold">Your assets may be subject to immediate freeze.</span>
        </p>
      ) : (
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          Searching global litigation databases... No direct matches found in currently active GBC datasets for this exact name.
          <span class="block mt-2 text-sm">Please verifying spelling or try our "Deep Scan" (Engine 1).</span>
        </p>
      )}
    </div>

    <!-- The "Proof" Card -->
    <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class={`col-span-2 border rounded-2xl p-8 backdrop-blur-sm relative overflow-hidden ${isMatch ? 'bg-gray-900/50 border-red-500/30' : 'bg-gray-900/20 border-gray-800'}`}>
             <!-- Background Texture -->
             <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10"></div>
             
             <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
                <!-- Risk Meter -->
                <div class="relative w-40 h-40 flex-shrink-0">
                    <svg class="w-full h-full transform -rotate-90">
                        <circle cx="80" cy="80" r="70" class="stroke-gray-800" stroke-width="12" fill="none"/>
                        <circle cx="80" cy="80" r="70" class={isMatch ? "stroke-red-600" : "stroke-green-600"} stroke-width="12" fill="none"
                                stroke-dasharray="440" stroke-dashoffset={440 - (440 * riskScore / 100)}/>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-5xl font-black text-white">{riskScore}</span>
                        <span class={`text-xs font-bold tracking-widest uppercase mt-1 ${isMatch ? 'text-red-500' : 'text-green-500'}`}>
                            {isMatch ? 'CRITICAL' : 'SAFE'}
                        </span>
                    </div>
                </div>

                <!-- Intelligence Details -->
                <div class="flex-1 w-full">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="bg-blue-500/20 text-blue-400 text-xs font-bold px-2 py-1 rounded">DATA SOURCE: GBC_OFFICIAL</span>
                        {isMatch && <span class="bg-red-500/20 text-red-400 text-xs font-bold px-2 py-1 rounded">VERIFIED</span>}
                    </div>
                    
                    {isMatch && dbRecord ? (
                        <div class="space-y-4">
                            <div class="bg-black/40 rounded p-4 border border-red-500/20">
                                <h3 class="text-gray-400 text-xs uppercase tracking-wider mb-2">Lawsuit Details</h3>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <div class="text-xs text-gray-500">Case Number</div>
                                        <div class="text-white font-mono">{dbRecord.case_number}</div>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">Brand Plaintiff</div>
                                        <div class="text-white font-mono">{dbRecord.brand_name}</div>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">Platform</div>
                                        <div class="text-white font-mono">{dbRecord.platform || 'General'}</div>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">Found At</div>
                                        <div class="text-white font-mono">{new Date(dbRecord.found_at).toLocaleDateString()}</div>
                                    </div>
                                </div>
                            </div>
                            
                           {dbRecord.store_url && (
                                <div class="text-xs text-gray-500 font-mono truncate">
                                    Linked Store: <span class="text-red-400">{dbRecord.store_url}</span>
                                </div>
                            )}
                        </div>
                    ) : (
                         <div class="bg-black/40 rounded p-4 border border-gray-800 text-center py-8">
                             <p class="text-gray-400 text-sm">No active lawsuit records found matching this identity.</p>
                             <p class="text-xs text-gray-600 mt-2">Database Updated: {new Date().toLocaleDateString()}</p>
                         </div>
                    )}
                </div>
             </div>
        </div>
    </div>

    <!-- Action Buttons -->
    {isMatch && (
        <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
            <div class="w-full max-w-xs text-center">
                <p class="text-gray-400 text-sm mb-2">Unlock Full Liability Report & Evidence</p>
                <PayPalButton amount="29.90" integrationId="sniper_defendant" />
            </div>
        </div>
    )}

  </main>
</div>

<script define:vars={{ isMatch, evidenceLink }}>
    // Payment Success Handler
    document.addEventListener('payment-success', (e) => {
        if (!isMatch) return;
        
        const payerName = e.detail.payer.name.given_name;
        // In Branch B (Sniper), we unlock the downloaded files
        console.log("Unlock Triggered", evidenceLink);
        
        alert(`PAYMENT CONFIRMED: ${payerName}\n\nUnlocking Federal Court Evidence Packet...`);
        
        if(evidenceLink) {
             window.location.href = evidenceLink;
        } else {
             // Fallback
             alert("Thank you. The report has been emailed to you.");
        }
    });
</script>
